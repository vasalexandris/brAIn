# Αντέγραψε αυτό το αρχείο σε .env.local και συμπλήρωσε τις τιμές.

# Κλειδί Gemini API. Χωρίς αυτό η εφαρμογή τρέχει με "ψεύτικο" μοντέλο (mock) για δοκιμές.
GEMINI_API_KEY=

# Μοντέλα (προαιρετικά). Το "γρήγορο" κάνει την αξιολόγηση και τον αναστοχασμό.
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FAST_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001

# Μυστικό για τα session cookies. Υποχρεωτικό σε production (π.χ. `openssl rand -hex 32`).
AUTH_SECRET=

# Βάση δεδομένων. Κενό = ενσωματωμένη Postgres (PGlite) στον φάκελο .data/
# Για εξωτερικό server: postgres://user:pass@host:5432/db
DATABASE_URL=
# Βάλε "no-verify" μόνο αν ο πάροχος απαιτεί SSL με πιστοποιητικό που δεν επαληθεύεται.
DATABASE_SSL=
